{
  "$defs": {
    "AngleMeasurement": {
      "additionalProperties": false,
      "description": "Counterclockwise orientation in degrees from property +X, in [0, 360].",
      "properties": {
        "confidence_level": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Coverage probability of an interval, if known.",
          "title": "Confidence Level"
        },
        "confidence_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Evidence quality score; not interval coverage.",
          "title": "Confidence Score"
        },
        "lower_bound": {
          "anyOf": [
            {
              "maximum": 360,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower Bound"
        },
        "method": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Provenance or calibration method; no default method is assumed.",
          "title": "Method"
        },
        "unit": {
          "const": "degree",
          "default": "degree",
          "title": "Unit",
          "type": "string"
        },
        "upper_bound": {
          "anyOf": [
            {
              "maximum": 360,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper Bound"
        },
        "value": {
          "maximum": 360,
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value"
      ],
      "title": "AngleMeasurement",
      "type": "object"
    },
    "AreaMeasurement": {
