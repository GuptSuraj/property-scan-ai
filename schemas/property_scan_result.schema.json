    "Polygon2D": {
      "additionalProperties": false,
      "description": "Ordered vertices; implicit closure, with an optional repeated final vertex.\n\nAt least three distinct points are required. Winding, intersections, holes,\ncollinearity, and planarity are not evaluated in this schema phase.",
      "properties": {
        "points": {
          "description": "Ordered metric vertices; no pixels.",
